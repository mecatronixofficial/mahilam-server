NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/little_mahilam
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# In production, authentication uses Secure, HTTP-only, SameSite=Lax cookies.
# Serve the frontend and API over HTTPS on the same site, such as app.example.com and api.example.com.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Performance and operations (all optional; defaults shown)
DATABASE_POOL_MAX=10
# On Vercel every function instance opens its own pool: use your provider's pooled connection string
# (e.g. Neon/Supabase pooler) for DATABASE_URL and set DATABASE_POOL_MAX to 1-3.
# How long public website content is cached in memory (0 disables). Admin edits clear it immediately.
PUBLIC_CACHE_TTL_MS=60000
# Requests slower than this are logged as warnings.
SLOW_REQUEST_MS=1000
# Number of reverse proxies in front of the API in production (for correct client IPs and rate limits).
TRUST_PROXY_HOPS=1
# Scheduled jobs (session cleanup, overdue fees, audit-log pruning). Set true on all but one instance.
DISABLE_CRON=false
# Vercel only: Vercel Cron calls GET /api/v1/tasks/run with this as a Bearer token (openssl rand -hex 32).
CRON_SECRET=
AUDIT_RETENTION_DAYS=365
TZ=Asia/Kolkata

# Cloudflare R2 (enable public access/custom domain and use its base URL below)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://media.example.com

# Resend
RESEND_API_KEY=
MAIL_FROM=Little Mahilam <notifications@example.com>
ADMIN_NOTIFICATION_EMAIL=

# Meta WhatsApp Cloud API: approved template body must have five placeholders
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_TO=919876543210
WHATSAPP_TEMPLATE_NAME=new_admission_enquiry
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=v23.0
